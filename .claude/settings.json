{
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Read(scripts/**)",
      "Read(public/**)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)"
    ],
    "deny": [
      "Read(.env*)"
    ]
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with [Claude Code](https://claude.ai/code)"
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo '$TOOL_INPUT' | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get(\"file_path\",\"\"))' 2>/dev/null); if [ -n \"$file\" ] && echo \"$file\" | grep -qE '\\.(ts|tsx|js|jsx|mjs)$'; then npx eslint --fix --quiet \"$file\" 2>/dev/null || true; fi",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
